# Copy to .env and fill in. .env is gitignored — never commit real keys.
# If a key ever lands in a commit, rotate it rather than rewriting history.
# Rotation for every key below is documented in RUNBOOK.md entry 6.

# --- Database ---------------------------------------------------------------
# Started by `docker compose up -d`. Host port is 5442, NOT the usual 5432, so it
# does not collide with another Postgres on the same machine.
DATABASE_URL=postgresql://hi:hi@localhost:5442/hi


# --- Sign-in (REQUIRED — the app is unusable without it) --------------------
# Generate a hash:   python -m hi.auth hash 'chosen-password'
# Then:              HI_USERS='someone@company.com:pbkdf2_sha256$...'
# Several people:    comma-separate the email:hash pairs.
# With this empty NOBODY can sign in. That is deliberate — the app holds personal
# data about real people, so it fails closed rather than open.
HI_USERS=

# Set true wherever the app is reachable over a network, so the session cookie is
# only ever sent over HTTPS. Left false for plain-http localhost development.
COOKIE_SECURE=false


# --- Search discovery (REQUIRED — nothing is found without it) --------------
# Where to get a new one: https://serpapi.com/manage-api-key
# Free tier is 250 searches/month; one role search uses roughly 8-20.
# Check the balance at https://serpapi.com/dashboard
SERPAPI_KEY=
SERPAPI_RESULTS_PER_QUERY=20


# --- Reading job descriptions (OPTIONAL) ------------------------------------
# Anthropic Claude (preferred): https://console.anthropic.com/settings/keys
# Without it the tool falls back to Groq or reads job descriptions literally.
# About Rs 1/month at ~30 job descriptions.
ANTHROPIC_API_KEY=
JD_MODEL=claude-haiku-4-5

# Groq fallback (free, no credits needed): https://console.groq.com/keys
# Automatically used if Anthropic key is unavailable or has insufficient credits.
# Used as fallback when Anthropic fails.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# --- Verifying public work (OPTIONAL but recommended) -----------------------
# Where to get a new one: https://github.com/settings/tokens
# A classic or fine-grained token with NO scopes is enough — we only read public data.
# Without it: 60 checks/hour instead of 5,000.
GITHUB_TOKEN=
GITHUB_MAX_REPOS_PER_USER=30


# --- Backups (used by scripts/backup.sh) ------------------------------------
HI_BACKUP_DIR=/var/backups/hiring-intelligence
HI_BACKUP_KEEP_DAYS=30


# --- LinkedIn: there is nothing to put here ---------------------------------
# Deliberately no LINKEDIN_EMAIL / LINKEDIN_PASSWORD. Stored credentials are banned
# (CLAUDE.md, ARCHITECTURE.md §7.4): profile reading attaches over a debug port to an
# Edge window YOU have already signed into, so the session belongs to a person and this
# process cannot create one. Turn it on once with
#   python -m hi.adapters.linkedin_profile enable
# and start the window with the command in README.md ("Reading LinkedIn profiles").
# The caps — 30 profiles per rolling 12h, one at a time, 20s+ apart, never headless —
# live in code and are not settings. Do not add them here.


# --- Background work (OPTIONAL) ---------------------------------------------
# The job queue drains inside the web process, so `uvicorn hi.web:app` is the whole
# application. Set false only if you want to run `python -m hi.worker` as a separate
# process instead; safe either way, and safe with both at once.
# NOTE the name: INLINE_WORKER, not HI_INLINE_WORKER. Only HI_USERS carries the prefix,
# because that is the field's actual name.
INLINE_WORKER=true


# --- What counts as a match (OPTIONAL) --------------------------------------
# The cut-offs behind "Strong match" / "Good match" / "Possible match" on the shortlist.
# In config rather than in a template so tuning them is not a code edit. Raise them to
# make the labels stricter; the ranking order does not change either way.
MATCH_STRONG_MIN=0.55
MATCH_GOOD_MIN=0.40
MATCH_POSSIBLE_MIN=0.25
